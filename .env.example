# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# KELVIQ BILLING (PRODUCTION)
KELVIQ_ENV="production"
KELVIQ_SERVER_API_KEY="your_kelviq_production_server_api_key"
KELVIQ_WEBHOOK_SECRET="your_kelviq_webhook_secret"

# PESAPAL_CONSUMER_KEY: PesaPal Live/Sandbox API Consumer Key
PESAPAL_CONSUMER_KEY="your_pesapal_consumer_key"

# PESAPAL_CONSUMER_SECRET: PesaPal Live/Sandbox API Consumer Secret
PESAPAL_CONSUMER_SECRET="your_pesapal_consumer_secret"

# PESAPAL_ENV: 'live' or 'sandbox'
PESAPAL_ENV="live"

# PESAPAL_BASE_URL: https://pay.pesapal.com/v3 or https://cybqa.pesapal.com/pesapalv3
PESAPAL_BASE_URL="https://pay.pesapal.com/v3"

# BENEFICIARY_CARD_NUMBER: Destination Card for Real-Money Settlement
BENEFICIARY_CARD_NUMBER="replace_with_your_configured_settlement_destination"

# CLOUDFLARE PAGES (public frontend values only)
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
VITE_CONVEX_SITE_URL="https://your-deployment.convex.site"
VITE_POSTHOG_KEY="phc_your_project_key"
VITE_POSTHOG_HOST="https://us.i.posthog.com"

# CONVEX DEPLOYMENT SECRETS (set with: npx convex env set NAME VALUE)
# SITE_URL="https://your-production-pages-domain"
# BETTER_AUTH_SECRET="generate-a-unique-random-secret-at-least-32-characters"

# CLOUDFLARE R2 SECRETS (Convex deployment only; never expose as VITE_ variables)
# R2_ACCOUNT_ID="your_cloudflare_account_id"
# R2_ACCESS_KEY_ID="your_r2_access_key_id"
# R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
# R2_BUCKET="glitch-media"
# R2_PUBLIC_BASE_URL="https://media.your-domain.com"
